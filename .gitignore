# Maven
target/

# maven-release-plugin working files. Gitignored deliberately: release:prepare
# refuses to start when the working copy has anything uncommitted, so a retried
# or interrupted release would block on its own leftovers.
release.properties
pom.xml.releaseBackup
pom.xml.tag
pom.xml.next
pom.xml.branch

# Sphinx documentation build output
doc/build/

# Node / TypeSpec toolchain (frontend-maven-plugin installs Node per module)
node_modules/
.node/
tsp-output/

# aron-ui build output and generated TypeScript client
aron-ui/dist/
aron-ui/src/api/generated/

# Local toolchain config (machine-specific paths) - copied from set-env.bat.template
/set-env.bat

# Local run sandbox(es) - the deployment-shaped working directory used for IDE
# runs and `java -jar` checks (see README, "Local run sandbox"). Holds the
# developer's own configuration and runtime data; never committed.
/run/
/run-*/

# IDE / OS
.idea/
*.iml
.DS_Store
.project
.classpath
.settings/
.vscode/
