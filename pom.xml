<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.lightcomp</groupId>
	<artifactId>aron</artifactId>
	<!--
	  The version line lives on a release branch (release-2.0.x for 2.0.x) and moves
	  only there; on main this stays a placeholder that is never released, so merging
	  main into a release branch never conflicts on it. See README, "Versions and
	  releases".
	-->
	<version>2.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>ARON</name>
	<description>Archiv online, new generation - connected records presentation</description>

	<!--
	  Project identity. Declared rather than inherited: spring-boot-starter-parent
	  supplies a url, licenses and developers of its own, so without these the
	  published pom credits VMware, Inc. and links to spring.io. The url is the
	  public mirror on GitHub, which is where a reader of this pom can actually
	  find the project.
	-->
	<url>https://github.com/elzasw/aron</url>
	<organization>
		<name>LightComp v.o.s.</name>
		<url>https://www.lightcomp.cz</url>
	</organization>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Petr Pytelka</name>
			<organization>LightComp v.o.s.</organization>
			<organizationUrl>https://www.lightcomp.cz</organizationUrl>
			<roles>
				<role>architect</role>
				<role>developer</role>
			</roles>
		</developer>
		<developer>
			<name>Karel Žáček</name>
			<organization>LightComp v.o.s.</organization>
			<organizationUrl>https://www.lightcomp.cz</organizationUrl>
			<roles>
				<role>developer</role>
			</roles>
		</developer>
	</developers>

	<!--
	  Module order is significant: the api contract module regenerates its OpenAPI
	  (consumed by aron-core's code generators and aron-ui's client generator)
	  first; distribution assembles the deployable jar and bundle zips it into the
	  release artifact, so those two build last. See PLAN.md.
	-->
	<modules>
		<module>api</module>
		<module>aron-core</module>
		<module>aron-ui</module>
		<module>distribution</module>
		<module>bundle</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- declared so -DskipTests also reaches the UI test execution (aron-ui) -->
		<skipTests>false</skipTests>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<cxf.version>4.0.0</cxf.version>
		<!-- TypeSpec / frontend toolchain (csc pattern): the build installs its own
		     Node into <module>/.node - no Node/npm needed on the host. Vite 6 needs
		     require(esm) support, available from Node 20.19/22.12. TypeSpec pinned to
		     the tested ~1.11 line. -->
		<frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
		<!-- Matches the build image (jdk25-nodejs26); the build still installs its
		     own copy so no Node is needed on a developer machine. -->
		<node.version>v26.5.0</node.version>
		<npm.version>11.17.0</npm.version>
		<springdoc.version>2.8.6</springdoc.version>
		<guava.version>31.1-jre</guava.version>
		<kryo.version>5.6.2</kryo.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<!-- Internal artifact; resolves from the LightComp Maven repository
		     (mvn.lightcomp.cz, configured as a mirror in settings.xml / on CI). -->
		<file-transfer.version>2.0</file-transfer.version>
		<!-- Current line. Discriminated inheritance reaches the generators in the
		     parent-only-property shape they all handle; subtypes mark the
		     discriminator @invisible(Lifecycle) in main.tsp, so no post-processing
		     of the emitted OpenAPI is involved. Redeclaring it in a child instead
		     breaks every generator line (7.6/7.15/7.24). -->
		<openapi-generator.version>7.24.0</openapi-generator.version>
		<!-- Embedded search engine (search.engine=lucene) - same Lucene generation
		     that Elasticsearch 9.x embeds. -->
		<lucene.version>10.5.0</lucene.version>
		<maven-release-plugin.version>3.1.1</maven-release-plugin.version>
		<!-- Git URL for maven-release-plugin, deliberately empty here: this
		     repository is publicly mirrored, so the internal Git host is supplied
		     by the release pipeline (-Daron.scm.url=...). Without it a release
		     stops with "Missing required setting: scm connection". -->
		<aron.scm.url/>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.lightcomp.ft</groupId>
				<artifactId>file-transfer</artifactId>
				<version>${file-transfer.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-common</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-frontend-jaxws</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-transports-http</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${guava.version}</version>
			</dependency>
			<dependency>
				<groupId>com.esotericsoftware</groupId>
				<artifactId>kryo</artifactId>
				<version>${kryo.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct-processor</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.lucene</groupId>
				<artifactId>lucene-core</artifactId>
				<version>${lucene.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.lucene</groupId>
				<artifactId>lucene-analysis-common</artifactId>
				<version>${lucene.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.cxf</groupId>
					<artifactId>cxf-codegen-plugin</artifactId>
					<version>${cxf.version}</version>
				</plugin>
				<plugin>
					<groupId>org.openapitools</groupId>
					<artifactId>openapi-generator-maven-plugin</artifactId>
					<version>${openapi-generator.version}</version>
				</plugin>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>${frontend-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>3.6.0</version>
				</plugin>
				<!-- Releases are cut on a release-<line> branch by the pipeline
				     (release:prepare + release:perform). Tags read aron-<version>;
				     the [maven-release-plugin] commit prefix is load-bearing - CI
				     skips builds of the plugin's own commits by matching it. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-release-plugin</artifactId>
					<version>${maven-release-plugin.version}</version>
					<configuration>
						<autoVersionSubmodules>true</autoVersionSubmodules>
						<tagNameFormat>aron-@{project.version}</tagNameFormat>
					</configuration>
				</plugin>
				<!-- Only the distribution module is published (it overrides this):
				     the released artifact is the executable jar, not the internal
				     library jars, which nothing outside this build consumes. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<configuration>
						<skip>true</skip>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!--
	  Consumed by maven-release-plugin only; the URL itself comes from the release
	  pipeline (aron.scm.url above), which is what keeps the internal Git host out
	  of this publicly mirrored repository. The release repository is supplied the
	  same way (-DaltDeploymentRepository), hence no distributionManagement here.
	-->
	<scm child.scm.connection.inherit.append.path="false"
		child.scm.developerConnection.inherit.append.path="false"
		child.scm.url.inherit.append.path="false">
		<connection>${aron.scm.url}</connection>
		<developerConnection>${aron.scm.url}</developerConnection>
		<!-- The browsable location is the public GitHub mirror; the internal Git
		     host stays out of this repository. Without a value here the URL
		     inherited from spring-boot-starter-parent would claim this source
		     lives in the Spring Boot repository. -->
		<url>https://github.com/elzasw/aron</url>
		<tag>HEAD</tag>
	</scm>

</project>
