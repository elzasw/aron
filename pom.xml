<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.lightcomp</groupId>
	<artifactId>aron2</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>ARON 2</name>
	<description>Archiv online, new generation - connected records presentation</description>

	<!--
	  Module order is significant: the api contract module regenerates its OpenAPI
	  (consumed by aron-core's code generators and aron-ui's client generator)
	  first; the distribution module assembles the deployable jar and therefore
	  builds last. See PLAN.md.
	-->
	<modules>
		<module>api</module>
		<module>aron-core</module>
		<module>aron-ui</module>
		<module>distribution</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- declared so -DskipTests also reaches the UI test execution (aron-ui) -->
		<skipTests>false</skipTests>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<cxf.version>4.0.0</cxf.version>
		<!-- TypeSpec / frontend toolchain (csc pattern): the build installs its own
		     Node into <module>/.node - no Node/npm needed on the host. Node 22 LTS:
		     current npm tooling (openapi-generator-cli) needs require(esm) support,
		     available from 20.19/22.12. TypeSpec pinned to the tested ~1.11 line. -->
		<frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
		<node.version>v22.12.0</node.version>
		<npm.version>10.9.0</npm.version>
		<springdoc.version>2.8.6</springdoc.version>
		<guava.version>31.1-jre</guava.version>
		<kryo.version>5.6.2</kryo.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<!-- Internal artifact; resolves from the LightComp Maven repository
		     (mvn.lightcomp.cz, configured as a mirror in settings.xml / on CI). -->
		<file-transfer.version>2.0</file-transfer.version>
		<!-- Current line. Discriminated inheritance reaches the generators in the
		     parent-only-property shape they all handle; subtypes mark the
		     discriminator @invisible(Lifecycle) in main.tsp, so no post-processing
		     of the emitted OpenAPI is involved. Redeclaring it in a child instead
		     breaks every generator line (7.6/7.15/7.24). -->
		<openapi-generator.version>7.24.0</openapi-generator.version>
		<!-- Embedded search engine (search.engine=lucene) - same Lucene generation
		     that Elasticsearch 9.x embeds. -->
		<lucene.version>10.5.0</lucene.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.lightcomp.ft</groupId>
				<artifactId>file-transfer</artifactId>
				<version>${file-transfer.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-common</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-frontend-jaxws</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-rt-transports-http</artifactId>
				<version>${cxf.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${guava.version}</version>
			</dependency>
			<dependency>
				<groupId>com.esotericsoftware</groupId>
				<artifactId>kryo</artifactId>
				<version>${kryo.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct-processor</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.lucene</groupId>
				<artifactId>lucene-core</artifactId>
				<version>${lucene.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.lucene</groupId>
				<artifactId>lucene-analysis-common</artifactId>
				<version>${lucene.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.cxf</groupId>
					<artifactId>cxf-codegen-plugin</artifactId>
					<version>${cxf.version}</version>
				</plugin>
				<plugin>
					<groupId>org.openapitools</groupId>
					<artifactId>openapi-generator-maven-plugin</artifactId>
					<version>${openapi-generator.version}</version>
				</plugin>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>${frontend-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>3.6.0</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
