<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.lightcomp</groupId>
		<artifactId>aron</artifactId>
		<version>2.0-SNAPSHOT</version>
	</parent>
	<artifactId>aron-core</artifactId>
	<name>aron-core</name>
	<description>ARON backend (library jar; the executable jar is built by the distribution module)</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-elasticsearch</artifactId>
		</dependency>
		<!-- Embedded search engine (search.engine=lucene): small/ES-less deployments,
		     tests and dev mode. See doc/search-port.md. -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-analysis-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web-services</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.lightcomp.ft</groupId>
			<artifactId>file-transfer</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-rt-frontend-jaxws</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-rt-transports-http</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
		</dependency>
		<dependency>
			<groupId>com.esotericsoftware</groupId>
			<artifactId>kryo</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy-jsr223</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct-processor</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- H2 backs tests and the dev profile (mvn spring-boot:run with profile
		     "dev"); optional=true keeps it OUT of the distribution jar -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/*.yaml</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>**/*.yaml</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-codegen-plugin</artifactId>
				<executions>
					<execution>
						<id>generate-sources</id>
						<phase>generate-sources</phase>
						<configuration>
							<sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
							<defaultOptions>
								<exceptionSuper>java.lang.RuntimeException</exceptionSuper>
							</defaultOptions>
							<wsdlOptions>
								<wsdlOption>
									<wsdl>${basedir}/src/main/resources/wsdl/aron_core.wsdl</wsdl>
									<extraargs>
										<extraarg>-autoNameResolution</extraarg>
									</extraargs>
								</wsdlOption>
								<wsdlOption>
									<wsdl>${basedir}/src/main/resources/wsdl/aron_transform_agent.wsdl</wsdl>
									<extraargs>
										<extraarg>-autoNameResolution</extraarg>
									</extraargs>
								</wsdlOption>
							</wsdlOptions>
						</configuration>
						<goals>
							<goal>wsdl2java</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<executions>
					<!-- old (frozen) API - module-local spec, external URLs under /api/aron -->
					<execution>
						<id>search-api</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generatorName>spring</generatorName>
							<inputSpec>${project.basedir}/src/main/resources/openapi/aron-api.yaml</inputSpec>
							<output>${project.build.directory}/generated-sources/api/rest</output>
							<generateSupportingFiles>false</generateSupportingFiles>
							<skipValidateSpec>true</skipValidateSpec>
							<configOptions>
								<sourceFolder>/</sourceFolder>
								<apiPackage>cz.aron.api.rest</apiPackage>
								<modelPackage>cz.aron.api.rest.model</modelPackage>
								<interfaceOnly>true</interfaceOnly>
								<skipDefaultInterface>true</skipDefaultInterface>
								<openApiNullable>false</openApiNullable>
								<useTags>true</useTags>
								<useSpringBoot3>true</useSpringBoot3>
							</configOptions>
						</configuration>
					</execution>
					<!-- new API (/api/v1) - server interfaces from the TypeSpec-emitted
					     contract in the api module; controllers in cz.aron.web.v1
					     implement them (spec paths carry the full /api/v1 prefix) -->
					<execution>
						<id>api-v1</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generatorName>spring</generatorName>
							<inputSpec>${project.basedir}/../api/openapi/aron-openapi-v1.yaml</inputSpec>
							<output>${project.build.directory}/generated-sources/api/rest-v1</output>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<sourceFolder>/</sourceFolder>
								<apiPackage>cz.aron.api.v1</apiPackage>
								<modelPackage>cz.aron.api.v1.model</modelPackage>
								<interfaceOnly>true</interfaceOnly>
								<skipDefaultInterface>true</skipDefaultInterface>
								<openApiNullable>false</openApiNullable>
								<useTags>true</useTags>
								<useSpringBoot3>true</useSpringBoot3>
							</configOptions>
						</configuration>
					</execution>
					<!-- typed Java client for integration tests (csc pattern): drives
					     the real HTTP API in tests; never used in production code -->
					<execution>
						<id>api-v1-test-client</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generatorName>java</generatorName>
							<library>restclient</library>
							<inputSpec>${project.basedir}/../api/openapi/aron-openapi-v1.yaml</inputSpec>
							<output>${project.build.directory}/generated-test-sources/v1-client</output>
							<addCompileSourceRoot>false</addCompileSourceRoot>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelDocumentation>false</generateModelDocumentation>
							<configOptions>
								<sourceFolder>/</sourceFolder>
								<apiPackage>cz.aron.test.api.v1</apiPackage>
								<modelPackage>cz.aron.test.api.v1.model</modelPackage>
								<invokerPackage>cz.aron.test.api.v1.invoker</invokerPackage>
								<openApiNullable>false</openApiNullable>
								<useJakartaEe>true</useJakartaEe>
								<dateLibrary>java8</dateLibrary>
								<useTags>true</useTags>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-v1-test-client-sources</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-test-sources/v1-client</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Declared for `mvn spring-boot:run` and build-info; repackage is unbound
			     because this module is a plain library jar - the executable jar is
			     produced by the distribution module. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>repackage</id>
						<phase>none</phase>
					</execution>
					<!-- META-INF/build-info.properties -> BuildProperties bean (the
					     version reported by /api/v1/system/info) -->
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  Dev mode (doc/search-port.md, S5): `mvn spring-boot:run -Pdev` runs the
		  whole stack with zero external services. The dev configuration is NOT
		  packaged - it lives in dev-data/application-dev.yml and is supplied at
		  runtime, like any other deployment configuration of this
		  configuration-driven platform.
		-->
		<profile>
			<id>dev</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<profiles>
								<profile>dev</profile>
							</profiles>
							<arguments>
								<argument>--spring.config.additional-location=file:./dev-data/</argument>
							</arguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
		  Optional Elasticsearch integration tests (see doc/search-port.md, S4).
		  Activation: mvn verify -Pes-it
		  Starts the OFFICIAL Elasticsearch distribution as a local process on port
		  19200 (downloaded automatically and cached - no local installation, no
		  Docker; a dev ES on 9200 does not collide), runs the *IT tests against it
		  (failsafe) and stops it. The default build never touches Elasticsearch.
		  The ES version matches the client line managed by the Spring Boot BOM.
		-->
		<profile>
			<id>es-it</id>
			<build>
				<plugins>
					<!-- Own ES launcher (doc/search-port.md, S4): download (cached in
					     ~/.m2/es-cache) and extract the official distribution, start on
					     port 19200 with a pidfile, stop after the ITs. Engine-agnostic by
					     design - the same pattern will serve OpenSearch if ever needed.
					     The version tracks what deployments install (current major);
					     client/server compatibility (Boot-managed 8.x client vs 9.x
					     server) is exactly what these ITs verify. No analysis plugins
					     needed - es_settings.json uses built-in analyzers only. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>start-elasticsearch</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target xmlns:unless="ant:unless">
										<property name="es.version" value="9.5.1"/>
										<property name="es.cache" value="${user.home}/.m2/es-cache"/>
										<property name="es.home" value="${project.build.directory}/elasticsearch-it"/>
										<!-- A pre-installed distribution (the CI image) is used as it is:
										     no download, no extraction, and above all no delete of a
										     directory this build does not own. Everything inside the guard
										     is provisioning; starting ES is common to both paths. -->
										<available property="es.preinstalled" file="${es.home}/bin/elasticsearch"/>
										<sequential unless:set="es.preinstalled">
											<condition property="es.dist" value="elasticsearch-${es.version}-windows-x86_64.zip">
												<os family="windows"/>
											</condition>
											<property name="es.dist" value="elasticsearch-${es.version}-linux-x86_64.tar.gz"/>
											<mkdir dir="${es.cache}"/>
											<!-- keep only the current version's distribution: without pruning
											     the cache grows by ~600MB with every es.version bump -->
											<delete quiet="true">
												<fileset dir="${es.cache}" includes="elasticsearch-*" excludes="${es.dist}"/>
											</delete>
											<get src="https://artifacts.elastic.co/downloads/elasticsearch/${es.dist}"
												dest="${es.cache}/${es.dist}" skipexisting="true"/>
											<delete dir="${es.home}" quiet="true"/>
											<mkdir dir="${es.home}"/>
											<exec osfamily="windows" executable="powershell" failonerror="true">
												<arg value="-NoProfile"/>
												<arg value="-Command"/>
												<arg value="Expand-Archive -Force '${es.cache}/${es.dist}' '${es.home}-tmp'; Get-ChildItem '${es.home}-tmp/elasticsearch-${es.version}' | Move-Item -Destination '${es.home}'; Remove-Item -Recurse -Force '${es.home}-tmp'"/>
											</exec>
											<!-- tar preserves the executable bits ant's untar cannot -->
											<exec osfamily="unix" executable="tar" failonerror="true">
												<arg value="-xzf"/>
												<arg value="${es.cache}/${es.dist}"/>
												<arg value="-C"/>
												<arg value="${es.home}"/>
												<arg value="--strip-components=1"/>
											</exec>
										</sequential>
										<!-- start with test-friendly settings; ES writes its JVM pid to es.pid -->
										<exec osfamily="windows" executable="powershell" failonerror="true">
											<arg value="-NoProfile"/>
											<arg value="-Command"/>
											<arg value="$env:ES_JAVA_OPTS='-Xms512m -Xmx512m'; Start-Process -FilePath '${es.home}/bin/elasticsearch.bat' -ArgumentList '-Ehttp.port=19200','-Etransport.port=19300','-Ecluster.name=aron2-it','-Ediscovery.type=single-node','-Expack.security.enabled=false','-p','${es.home}/es.pid' -WindowStyle Hidden"/>
										</exec>
										<exec osfamily="unix" executable="${es.home}/bin/elasticsearch" failonerror="true">
											<env key="ES_JAVA_OPTS" value="-Xms512m -Xmx512m"/>
											<arg value="-d"/>
											<arg value="-p"/>
											<arg value="${es.home}/es.pid"/>
											<arg value="-Ehttp.port=19200"/>
											<arg value="-Etransport.port=19300"/>
											<arg value="-Ecluster.name=aron2-it"/>
											<arg value="-Ediscovery.type=single-node"/>
											<arg value="-Expack.security.enabled=false"/>
										</exec>
										<waitfor maxwait="180" maxwaitunit="second" checkevery="2"
											checkeveryunit="second" timeoutproperty="es.start.timeout">
											<http url="http://localhost:19200/_cluster/health"/>
										</waitfor>
										<fail if="es.start.timeout"
											message="Elasticsearch did not become available on port 19200 within 180s - see ${es.home}/logs"/>
									</target>
								</configuration>
							</execution>
							<execution>
								<id>stop-elasticsearch</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<property name="es.home" value="${project.build.directory}/elasticsearch-it"/>
										<exec osfamily="windows" executable="powershell">
											<arg value="-NoProfile"/>
											<arg value="-Command"/>
											<arg value="if (Test-Path '${es.home}/es.pid') { Stop-Process -Id (Get-Content '${es.home}/es.pid') -Force -ErrorAction SilentlyContinue }"/>
										</exec>
										<exec osfamily="unix" executable="sh">
											<arg value="-c"/>
											<arg value="[ -f '${es.home}/es.pid' ] &amp;&amp; kill $(cat '${es.home}/es.pid') || true"/>
										</exec>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<es.it.port>19200</es.it.port>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
