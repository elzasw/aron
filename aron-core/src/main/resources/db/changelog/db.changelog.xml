<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">
    <property name="now" value="now()" dbms="postgresql"/>
    <property name="id" value="bigint" dbms="postgresql"/>
    <property name="uuid" value="char(36)" dbms="postgresql"/>
    <property name="blob" value="bytea" dbms="postgresql"/>

    <changeSet id="1" author="karel.zacek@lightcomp.cz">

<!--      
    <validCheckSum>ANY</validCheckSum>
-->
    
        <createTable tableName="apu_source">
            <column name="apu_source_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_apu_source"/>
            </column>
            <column name="uuid" type="${uuid}"/>
            <column name="published" type="datetime"/>
        </createTable>
        <createTable tableName="apu">
            <column name="apu_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_apu"/>
            </column>
            <column name="uuid" type="${uuid}"/>
            <column name="name" type="nclob"/>
            <column name="indexed_name" type="nclob"/>
            <column name="description" type="nclob"/>
            <column name="result" type="nclob"/>
            <column name="permalink" type="varchar(255)"/>
            <column name="published" type="boolean"/>
            <column name="apu_source_id" type="${id}">
                <constraints referencedTableName="apu_source" referencedColumnNames="apu_source_id" foreignKeyName="FK_apu_source"/>
            </column>
            <column name="parent_id" type="${id}">
                <constraints referencedTableName="apu" referencedColumnNames="apu_id" foreignKeyName="FK_apu_parent"/>
            </column>
            <column name="type" type="varchar(255)"/>
            <column name="ordr" type="int" value="0"/>
            <column name="indexed" type="boolean"/>
            <column name="depth" type="int"/>
            <column name="pos" type="int"/>
            <column name="child_cnt" type="int"/>
            <column name="reindex" type="boolean"/>
            <column name="data" type="${blob}"/>
        </createTable>
        <createTable tableName="apu_attachment">
            <column name="apu_attachment_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_apu_attachment"/>
            </column>
            <column name="uuid" type="${uuid}"/>
            <column name="name" type="nvarchar(255)"/>
            <column name="order" type="int" value="0"/>
            <column name="apu_id" type="${id}">
                <constraints referencedTableName="apu" referencedColumnNames="apu_id" foreignKeyName="FK_apu_attachment_apu"/>
            </column>
        </createTable>
        <createTable tableName="digital_object">
            <column name="digital_object_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_digital_object"/>
            </column>
            <column name="uuid" type="${uuid}"/>
            <column name="permalink" type="varchar(255)"/>
            <column name="name" type="nvarchar(255)"/>
            <column name="order" type="int" value="0"/>
            <column name="apu_id" type="${id}">
                <constraints referencedTableName="apu" referencedColumnNames="apu_id" foreignKeyName="FK_digital_object_apu"/>
            </column>
            <column name="license_code" type="nclob"/>
        </createTable>
        <createTable tableName="digital_object_file">
            <column name="digital_object_file_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_digital_object_file"/>
            </column>
            <column name="uuid" type="${uuid}"/>
            <column name="permalink" type="nvarchar(255)"/>
            <column name="order" type="int"/>
            <column name="type" type="varchar(255)"/>
            <column name="name" type="nclob"/>
            <column name="referenced_file" type="nvarchar(2048)"/>
            <column name="content_type" type="varchar(255)"/>
            <column name="size" type="bigint"/>
            <column name="digital_object_id" type="${id}">
                <constraints referencedTableName="digital_object" referencedColumnNames="digital_object_id" foreignKeyName="FK_digital_object_file_digital_object"/>
            </column>
            <column name="attachment_id" type="${id}">
                <constraints referencedTableName="apu_attachment" referencedColumnNames="apu_attachment_id" foreignKeyName="FK_digital_object_file_attachment"/>
            </column>
        </createTable>
        <createTable tableName="relation">
            <column name="relation_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_relation"/>
            </column>
            <column name="apu_source_id" type="${id}">
                <constraints referencedTableName="apu_source" referencedColumnNames="apu_source_id" foreignKeyName="FK_relation_apu_source"/>
            </column>
            <column name="source" type="${uuid}"/>
            <column name="relation" type="varchar(255)"/>
            <column name="target" type="${uuid}"/>
            <column name="remove" type="boolean"/>
        </createTable>
        <createTable tableName="queued_apu">
            <column name="queued_apu_id" type="${id}" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_queued_apu"/>
            </column>
            <column name="created" type="datetime"/>
            <column name="apu_id" type="${uuid}"/>
            <column name="request_sent" type="boolean"/>
        </createTable>
        
        <createIndex indexName="idx_apu_apu_source_id"
            tableName="apu" unique="false">
            <column name="apu_source_id" />
        </createIndex>
        <createIndex indexName="idx_apu_parent_id"
            tableName="apu" unique="false">
            <column name="parent_id" />
        </createIndex>
<!--        
        <createIndex indexName="idx_apu_id_pos"
            tableName="apu" unique="true">
            <column name="parent_id" />
            <column name="pos" />
        </createIndex>
-->        
        <createIndex indexName="idx_apu_attachment_apu_id"
            tableName="apu_attachment" unique="false">
            <column name="apu_id" />
        </createIndex>
        <createIndex indexName="idx_digital_object_file_attachment_id"
            tableName="digital_object_file" unique="false">
            <column name="attachment_id" />
        </createIndex>
        <createIndex indexName="idx_digital_object_file_digital_object_id"
            tableName="digital_object_file" unique="false">
            <column name="digital_object_id" />
        </createIndex>
        <createIndex indexName="idx_relation_apu_source"
            tableName="relation" unique="false">
            <column name="apu_source_id" />
        </createIndex>
        <createIndex indexName="idx_relation_source"
            tableName="relation" unique="false">
            <column name="source" />
        </createIndex>
        <createIndex indexName="idx_relation_target"
            tableName="relation" unique="false">
            <column name="target" />
        </createIndex>
        <createIndex indexName="idx_digital_object_apu_id"
            tableName="digital_object" unique="false">
            <column name="apu_id" />
        </createIndex>
        <createIndex indexName="idx_queued_apu_apu_id"
            tableName="queued_apu" unique="true">
            <column name="apu_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>