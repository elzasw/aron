{
  "index": {
    "analysis": {
      "analyzer": {
        "text_short_keyword": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter":  ["max_token_length_trunc"]
        },
        "text_long_keyword": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter":  ["200_char_trunc"]
        },
        "text_long_keyword_ci": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter":  ["lowercase", "200_char_trunc"]
        },
        "folding": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter":  ["lowercase", "asciifolding", "max_token_length_trunc"]
        },
        "folding_and_tokenizing": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "max_token_length_trunc"]
        },
        "folding_and_tokenizing_stop": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "stop_filter", "asciifolding"]
        }
      },
      "filter": {
        "stop_filter": {
          "type": "stop",
          "stopwords": ["__STOP_WORDS__"]
        },
        "200_char_trunc": {
          "type": "truncate",
          "length": 200
        },
        "max_token_length_trunc": {
          "type": "truncate",
          "length": 28000
        }
      }
    }
  }
}
