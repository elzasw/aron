<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.lightcomp</groupId>
		<artifactId>aron</artifactId>
		<version>2.0.0-BETA-1</version>
	</parent>
	<artifactId>aron-ui</artifactId>
	<!-- jar (not pom): the built SPA is packaged as a resource jar so the
	     distribution module can put it on the classpath. -->
	<packaging>jar</packaging>
	<name>ARON 2 UI</name>
	<description>New portal UI: React + Vite + TypeScript + Fluent UI v9. Generates its
		TypeScript client from the committed api/openapi/aron-openapi-v1.yaml and builds
		with Vite. Dev loop: `npm run dev` (proxies /api to :8080, ideally the aron-core
		dev mode). The Maven build packages dist/ into this jar: hashed assets under
		META-INF/resources/ (served statically by Spring Boot), index.html under
		META-INF/aron-ui/ where IndexController picks it up as the SPA shell template
		(it must never be served raw - it contains deployment-prefix tokens).</description>

	<build>
		<plugins>
			<!-- TypeScript client of the /api/v1 contract, from the committed YAML the
			     api module emits. The generator is a Java tool, so Maven runs it - never
			     an npm script: its npm wrapper resolves `java` from PATH alone, while the
			     npm scripts must stay JVM-free so the Vite dev loop needs nothing but the
			     Node installed below. The version comes from the root pom, the same that
			     generates the server interfaces. Output is gitignored and never
			     hand-edited; cleanupOutput drops what a contract rename orphaned. -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>api-v1-ts-client</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generatorName>typescript-fetch</generatorName>
							<inputSpec>${project.basedir}/../api/openapi/aron-openapi-v1.yaml</inputSpec>
							<output>${project.basedir}/src/api/generated</output>
							<skipValidateSpec>true</skipValidateSpec>
							<cleanupOutput>true</cleanupOutput>
							<!-- TypeScript output: nothing here belongs on a Java source root -->
							<addCompileSourceRoot>false</addCompileSourceRoot>
							<configOptions>
								<supportsES6>true</supportsES6>
								<withInterfaces>true</withInterfaces>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<configuration>
					<nodeVersion>${node.version}</nodeVersion>
					<npmVersion>${npm.version}</npmVersion>
					<installDirectory>${project.basedir}/.node</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<phase>generate-resources</phase>
					</execution>
					<execution>
						<id>npm-install</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>install</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm-build</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>compile</phase>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
					<execution>
						<!-- Accessibility gate (doc/accessibility.md §5): eslint-plugin-jsx-a11y
						     turns a missing label or a role misuse into a build failure. Runs
						     before the tests, in the same phase, so -DskipTests skips both. -->
						<id>npm-lint</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>test</phase>
						<configuration>
							<arguments>run lint</arguments>
							<skip>${skipTests}</skip>
						</configuration>
					</execution>
					<execution>
						<!-- Vitest + jsdom; no browser, no external service, so it fits the
						     project's "mvn test needs nothing installed" rule. Includes axe
						     assertions over rendered markup (src/test/a11y.ts). -->
						<id>npm-test</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>test</phase>
						<configuration>
							<arguments>run test</arguments>
							<skip>${skipTests}</skip>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Package the Vite output (dist/) into the jar. index.html goes to
			     META-INF/aron-ui/ (shell template for IndexController), everything
			     else to META-INF/resources/ (plain Spring Boot static content). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-ui-dist</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/dist</directory>
									<targetPath>resources</targetPath>
									<excludes>
										<exclude>index.html</exclude>
									</excludes>
								</resource>
								<resource>
									<directory>${project.basedir}/dist</directory>
									<targetPath>aron-ui</targetPath>
									<includes>
										<include>index.html</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
