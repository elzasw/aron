  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "ARON portal UI (React + Fluent UI v9); consumes the /api/v1 contract.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
